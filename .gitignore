# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-mineru
.venv-vlm

# Molecule data is local. Only molecules/example_molecule/ (the template
# layout) is tracked; create your own molecules/<name>/ folder to work in and
# it stays out of git.
molecules/*
!molecules/example_molecule/

# Files
archive/
docs/

# Local scratch space (crops, debug scripts, issue-tracker notes) - not versioned
.scratch/

# Claude Code local/session state
.claude/settings.local.json
.claude/scheduled_tasks.lock
